# ============================================
# Production Environment Variables Template
# ============================================
# این فایل یک نمونه است. برای استفاده:
# 1. این فایل را به .env.production کپی کنید
# 2. مقادیر را با اطلاعات واقعی هاست خود جایگزین کنید
# 3. یا در cPanel Node.js App Manager متغیرهای محیطی را تنظیم کنید

# ============================================
# Database Configuration (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=false

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
NEXT_PUBLIC_URL=https://yourdomain.com

# ============================================
# cPanel Node.js App Manager Configuration
# ============================================
# در cPanel Node.js App Manager، این متغیرها را تنظیم کنید:
# - APP_PORT: پورت اختصاص داده شده توسط cPanel (معمولاً به صورت خودکار تنظیم می‌شود)
# - HOSTNAME: 0.0.0.0 (برای گوش دادن به همه اینترفیس‌ها)
# - NODE_OPTIONS: --max-old-space-size=4096 (اختیاری، برای محدود کردن حافظه)

# ============================================
# Zarinpal Payment Gateway
# ============================================
# Merchant ID خود را از پنل زرین‌پال دریافت کنید
ZARINPAL_MERCHANT_ID=your-merchant-id

# ============================================
# NextAuth Configuration (if using)
# ============================================
# برای تولید secret key می‌توانید از دستور زیر استفاده کنید:
# openssl rand -base64 32
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-secret-key-here

# ============================================
# JWT Secret (if using custom JWT)
# ============================================
JWT_SECRET=your-jwt-secret-key

# ============================================
# Optional: Logging
# ============================================
# LOG_LEVEL=info

